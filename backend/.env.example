# Copy this file to .env and fill in your real values.

# Supabase Postgres connection string.
# Find it in: Supabase project -> Project Settings -> Database -> Connection string -> URI
# (choose "Transaction pooler" mode, port 6543 — best for a typical web backend).
# Supabase gives you a "postgresql://..." URI — just add "+psycopg2" after "postgresql"
# so SQLAlchemy uses the psycopg2 driver, and keep sslmode=require.
DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:[email protected]:6543/postgres?sslmode=require

# If you instead copied the "Direct connection" URI (port 5432, host db.<project-ref>.supabase.co),
# that also works — just apply the same +psycopg2 and sslmode=require tweaks:
# DATABASE_URL=postgresql+psycopg2://postgres:[email protected]:5432/postgres?sslmode=require

# How many new goals are surfaced on the home screen each day is now a
# setting stored in the database (editable from the app itself) — no env
# var for it anymore.

# Free Groq API key, used to pick each day's goal selection.
# Get one at https://console.groq.com/keys — no credit card required.
# Runs on the first /api/today request of each new calendar day (not on a
# schedule). If unset, or if it fails, it falls back to deterministic
# selection instead (no LLM) — see README for details.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma separated origins allowed to call the API (your frontend URL)
CORS_ORIGINS=http://localhost:5173